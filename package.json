{
  "name": "jungle-gaming-wagering",
  "private": true,
  "scripts": {
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "migration:up": "bun src/migrate.ts up",
    "migration:down": "bun src/migrate.ts down",
    "test:unit": "bun test test/unit.test.ts",
    "test:integration": "bun test test/integration.test.ts",
    "test:concurrency": "bun test test/concurrency.test.ts",
    "test:audit": "bun test test/adversarial.test.ts",
    "test:security": "bun test test/final-audit.test.ts",
    "test:fifo-window": "bun test test/fifo-window.test.ts",
    "test:broker-crash": "bun test test/broker-crash.test.ts",
    "test:load": "bun test test/local-load.test.ts",
    "test": "bun run test:unit && bun run test:integration && bun run test:concurrency"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.900.0",
    "@mikro-orm/core": "~6.6.0",
    "@mikro-orm/migrations": "~6.6.0",
    "@mikro-orm/postgresql": "~6.6.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "overrides": {
    "ajv": "8.18.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "~5.9.3"
  }
}
